# Convex writes the real value to backend/.env.local when you run `npm run convex:dev`.
# Example: https://happy-animal-123.convex.cloud
CONVEX_URL=
CONVEX_DEPLOYMENT=
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Run `npm run auth:setup` to generate matching RSA keys and configure Convex.
JWT_PRIVATE_KEY_BASE64=
NEST_JWKS_BASE64=
NEST_AUTH_SECRET=
